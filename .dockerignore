# flyctl launch added from .gitignore
# =============================================================================
# .gitignore — safety-critical: keeps secrets and report data out of version control.
# =============================================================================

# Secrets: webhook URLs + Anthropic API key live here, never committed.
**/.env

# Local project registry: holds machine-specific repo paths (and is user-created
# from orion.toml.example). The committed sample is orion.toml.example, not this.
**/orion.toml

# State store: contains report history (redacted bodies, but still local data).
**/*.sqlite3
**/*.sqlite3-journal

# Virtual environments — never commit the local interpreter/site-packages.
**/.venv
**/venv

# Node deps + Vite cache: the SPA build stage runs `npm ci` itself, so the host's
# web/node_modules must NOT enter the build context (huge + would overlay the clean
# install). web/dist is covered by **/dist below — the build regenerates it.
**/node_modules
**/.vite

# Python build / cache artifacts.
**/__pycache__
**/*.py[cod]
**/*.egg-info
**/.pytest_cache
**/build
**/dist

# flyctl launch added from .pytest_cache/.gitignore
# Created by pytest automatically.
.pytest_cache/**/*

# flyctl launch added from .venv/.gitignore
.venv/**/*
fly.toml

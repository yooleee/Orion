# =============================================================================
# .env.example — copy to `.env` and fill in. `.env` is gitignored; never commit it.
# -----------------------------------------------------------------------------
# Orion reads secrets from the environment (loaded from .env). The config file
# (orion.toml) only names WHICH env var holds each webhook URL — the URLs and the
# API key live here, so the shareable config never contains a secret.
# =============================================================================

# Anthropic API key for the summarizer (raw lane only). Get one at console.anthropic.com.
# Needed only with the default Anthropic backend. If you set a LOCAL summarizer in
# orion.toml ([summarizer] provider = "local"), no API key is required — unless that
# endpoint needs one, in which case add a variable matching its `api_key_env`, e.g.
#   LOCAL_LLM_KEY=...
ANTHROPIC_API_KEY=sk-ant-...

# One webhook URL per recipient. The env-var name must match the
# `webhook_env_var` you set for that recipient in orion.toml. Discord and Slack
# recipients each name their own variable here.
ORION_DISCORD_WEBHOOK_ALEX=https://discord.com/api/webhooks/XXXX/YYYY

# Slack incoming-webhook URL for a Slack recipient (create one per channel at
# api.slack.com/messaging/webhooks). Same indirection as Discord — the URL lives
# here, never in orion.toml.
ORION_SLACK_WEBHOOK_SAM=https://hooks.slack.com/services/XXXX/YYYY/ZZZZ

# Bearer token for the OPTIONAL hosted relay (C1). Needed only if you enable the
# [relay] table in orion.toml; the variable name must match its `token_env_var`.
# The same token is given to the relay server (via `orion relay-serve --token-env`)
# so the two sides share one secret. Generate a long random value, e.g.
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
ORION_RELAY_TOKEN=replace-with-a-long-random-token

# Dashboard READ secret for the relay's web view (HTTP Basic auth). Lives ONLY on the
# machine that runs `orion relay-serve` (it is not part of any project's orion.toml).
# REQUIRED when you bind the relay to a non-loopback host (e.g. to deploy it) — the
# server refuses to start otherwise, so the dashboard is never world-readable. On
# loopback (the default) it is optional. Any username works; this is the password.
# Generate a long random value the same way as the ingest token above.
ORION_RELAY_VIEW_TOKEN=replace-with-a-long-random-password

# Tokens for the OPTIONAL native Slack bot (C2-bots, `orion bot`). Needed only if
# you enable the [bot] table in orion.toml; the variable names must match its
# `token_env_var` / `app_token_env_var`. These are NOT webhook URLs — they come from
# a Slack APP (api.slack.com/apps) with Socket Mode enabled. See docs/slack-bot.md.
#   - Bot token (xoxb-…): OAuth & Permissions → Bot User OAuth Token.
#   - App-level token (xapp-…): Basic Information → App-Level Tokens, created with the
#     connections:write scope (this is what Socket Mode uses to open its WebSocket).
ORION_SLACK_BOT_TOKEN=xoxb-replace-with-your-slack-bot-token
ORION_SLACK_APP_TOKEN=xapp-replace-with-your-slack-app-level-token

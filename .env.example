# =============================================================================
# .env.example — copy to `.env` and fill in. `.env` is gitignored; never commit it.
# -----------------------------------------------------------------------------
# Orion reads secrets from the environment (loaded from .env). The config file
# (orion.toml) only names WHICH env var holds each webhook URL — the URLs and the
# API key live here, so the shareable config never contains a secret.
# =============================================================================

# Anthropic API key for the summarizer (raw lane only). Get one at console.anthropic.com.
# Needed only with the default Anthropic backend. If you set a LOCAL summarizer in
# orion.toml ([summarizer] provider = "local"), no API key is required — unless that
# endpoint needs one, in which case add a variable matching its `api_key_env`, e.g.
#   LOCAL_LLM_KEY=...
ANTHROPIC_API_KEY=sk-ant-...

# One webhook URL per recipient. The env-var name must match the
# `webhook_env_var` you set for that recipient in orion.toml. Discord and Slack
# recipients each name their own variable here.
ORION_DISCORD_WEBHOOK_ALEX=https://discord.com/api/webhooks/XXXX/YYYY

# Slack incoming-webhook URL for a Slack recipient (create one per channel at
# api.slack.com/messaging/webhooks). Same indirection as Discord — the URL lives
# here, never in orion.toml.
ORION_SLACK_WEBHOOK_SAM=https://hooks.slack.com/services/XXXX/YYYY/ZZZZ

# THIS machine's contributor key for the OPTIONAL relay (C1 / C3). Needed only if you
# enable the [relay] table in orion.toml; the variable name must match its `token_env_var`.
# The relay mints it: `orion relay-user add <name> --role contributor --project <p> --key-only`
# (run against a relay whose admin token you hold). Each pushing machine carries its OWN key —
# there is no shared ingest token, and the relay itself never reads this variable.
ORION_RELAY_TOKEN=replace-with-the-key-relay-user-add-printed

# Dashboard secrets for the relay's web view (C3 multi-party). All live ONLY on the
# machine that runs `orion relay-serve` (not in any project's orion.toml). Generate each
# as its own long random value (python -c "import secrets; print(secrets.token_urlsafe(32))"),
# and keep them INDEPENDENT — do not reuse one value for another.
#
# View token: now the BOOTSTRAP-ADMIN login key (no longer HTTP Basic). It lets you log in
# only while no users have been provisioned yet, so a fresh deploy is not locked out. It is
# also what the fail-closed guard requires before the relay may bind beyond loopback, so it
# is REQUIRED on a non-loopback host. Once you provision real users it stops working (unless
# you pass `orion relay-serve --allow-legacy-admin`).
ORION_RELAY_VIEW_TOKEN=replace-with-a-long-random-password
# Per-user-key pepper: ALWAYS required by `relay-serve`. It hashes the stored key verifiers —
# every contributor key that authenticates a push and every login key — so without it the relay
# could verify nothing; it refuses to start rather than 401 every push silently.
ORION_RELAY_USER_PEPPER=replace-with-a-long-random-secret
# Session signing key: REQUIRED whenever the dashboard is access-gated (a view token or an
# admin token is set). It signs the login session cookie.
ORION_RELAY_SESSION_KEY=replace-with-a-long-random-secret
# Admin token for provisioning (`orion relay-user add/list/deactivate`). SEPARATE from every push
# credential on purpose: whoever can push reports must not be able to create users. Needed only
# if you provision per-user accounts; name it in [relay].admin_token_env_var.
ORION_RELAY_ADMIN_TOKEN=replace-with-a-long-random-token

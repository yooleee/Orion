# =============================================================================
# orion.toml.example — copy to `orion.toml` and edit. `orion.toml` is gitignored
# (it holds machine-specific repo paths). Orion only READS this file.
# -----------------------------------------------------------------------------
# This is the project registry: which projects Orion tracks, how much to share,
# and who receives the report. Secrets are NOT here — each recipient names an env
# var (webhook_env_var) that holds its webhook URL in .env.
# =============================================================================

# Where the sqlite state store lives. A relative path is resolved next to this
# config file. Tracks the last-reported commit per project + report history.
state_db = "orion.sqlite3"

# Time zone for human-facing timestamps in delivered messages (an IANA zone name).
# OPTIONAL — defaults to "America/Los_Angeles", which matches the relay dashboard's
# display so a report reads the same time in the chat message and on the dashboard.
# Set this if your recipients are in another zone (e.g. "UTC", "Europe/London").
# display_timezone = "America/Los_Angeles"

# Which LLM summarizes the raw git lane (the one step that calls an LLM). This
# whole table is OPTIONAL — omit it and Orion uses Anthropic's Claude Haiku 4.5,
# the lightest model adequate for summarization. The choice is GLOBAL (one
# summarizer for every project). Structured signals (tasks, notes, intake) never
# call an LLM regardless of this setting.
#
# To step up to a stronger Anthropic model (only if Haiku misses nuance on real
# diffs — confirm empirically first):
# [summarizer]
# provider = "anthropic"
# model    = "claude-sonnet-4-6"
#
# To summarize with a LOCAL model instead (keeps activity on your machine — only
# delivery makes an outbound call). `base_url` must point at any OpenAI-compatible
# chat endpoint (Ollama, llama.cpp server, LM Studio, vLLM — Ollama exposes one at
# http://localhost:11434/v1). `model` is the local model name and is required.
# Most local servers need no key; set `api_key_env` (naming a .env variable) only
# for an endpoint that requires one.
#
# Pick a model that is "lightest ADEQUATE" — adequate-for-quality comes first.
# Summarizing real diffs needs a reasonably capable model; treat the cloud default
# (Haiku 4.5) as the quality bar. Very small models degrade noticeably (a 0.5B
# model in testing produced rough, partly hallucinated summaries), so prefer a
# capable instruct model (~7-8B or better) for the local backend.
# [summarizer]
# provider    = "local"
# base_url    = "http://localhost:11434/v1"
# model       = "llama3.1:8b"
# api_key_env = "LOCAL_LLM_KEY"   # optional; omit when the endpoint needs no key

# OPTIONAL hosted relay (C1). When enabled, Orion ALSO pushes the portable report
# blob (the same structured data, already twice-redacted) to a relay that stores
# it and serves a read-only web dashboard — IN ADDITION to your Discord/Slack
# delivery, which is unchanged. This whole table is opt-in: omit it (or set
# enabled = false) and Orion pushes nowhere and behaves exactly as before. The
# choice is GLOBAL (one relay for every project). A relay push failure is reported
# but never blocks or fails a run. Run the reference relay locally with
# `orion relay-serve` (see docs/new-project-setup.md).
#
# `url` is the relay's ingest endpoint. `token_env_var` names a .env variable
# holding the Bearer token the push is authenticated with — the token itself lives
# in .env, never here (same indirection as a recipient's webhook_env_var).
# NOTE: the dashboard's READ secret is a SERVE-side concern, not a field here — it is
# set on the machine running `orion relay-serve` (ORION_RELAY_VIEW_TOKEN in its .env),
# and is REQUIRED before the relay can bind beyond loopback. See .env.example.
# [relay]
# enabled       = true
# url           = "http://127.0.0.1:8787/ingest"
# token_env_var = "ORION_RELAY_TOKEN"

# OPTIONAL native Slack bot (C2-bots) — two-way in chat. When enabled and run with
# `orion bot`, a supervisor's reply in a mapped Slack channel is relayed into that
# project's LATEST report as a comment (visible on the dashboard AND via
# `orion comments`, exactly like a dashboard comment). This is opt-in: omit the
# table (or set enabled = false) and no bot runs. The choice is GLOBAL (one bot
# process serves every project). The bot writes INTO the [relay] above — it reuses
# the relay's `url` and `token_env_var`, so [relay] must ALSO be enabled.
#
# Requires the optional extra: pip install orion[slack-bot] (pulls in slack-bolt).
# Needs a Slack app with Socket Mode ON, the channels:history + users:read scopes,
# the message.channels event subscription, and the bot invited to each channel.
# See docs/slack-bot.md for the full walkthrough.
#
# `token_env_var` names the .env var holding the bot token (xoxb-…);
# `app_token_env_var` names the one holding the Socket Mode app-level token (xapp-…).
# Both are NAMES — the tokens live in .env, never here. Each [[bot.channels]] binds
# one Slack channel id to one project (turn on Developer Mode in Slack, then
# right-click a channel → Copy → Copy channel ID).
# [bot]
# enabled           = true
# platform          = "slack"
# token_env_var     = "ORION_SLACK_BOT_TOKEN"
# app_token_env_var = "ORION_SLACK_APP_TOKEN"
#
#   [[bot.channels]]
#   channel_id = "C07ABC123"   # the Slack channel to listen in
#   project    = "orion"       # which project its replies attach to

# One [projects.<name>] table per tracked project. <name> is what you pass to
# `orion report <name>`.
[projects.orion]
# Absolute path (or ~) to the local git repo to read activity from.
# Windows: a backslash is a TOML escape, so use forward slashes
# (repo_path = "C:/Users/you/orion") or a single-quoted literal
# (repo_path = 'C:\Users\you\orion'). A double-quoted "C:\Users\..." is misread.
repo_path = "/home/yoolee/orion"

# How much detail leaves the machine. "high_level" (default, safest) sends only
# commit messages + a diffstat — NO code diff. "detailed" sends a capped,
# secret-filtered diff as well. When in doubt, stay high_level.
share_level = "high_level"

# Unattended-delivery opt-in. Default false: every run previews in your terminal
# before anything is sent. Set true ONLY for a project you want a scheduler to
# deliver without a human watching — and even then it takes effect ONLY when the
# run also passes `--yes` (e.g. `orion report --all --yes`). Without `--yes` the
# preview always shows (a human is present); `--yes` on a project with
# auto_send=false skips it and sends nothing. BOTH are required — defense in
# depth. For unattended projects, prefer share_level = "high_level".
# See docs/scheduling.md for the per-OS scheduler setup.
# auto_send = false

# Which signals are collected — each independently toggleable here. Supported:
#   "git"   — raw git activity (summarized by Claude on the raw lane)
#   "tasks" — newly-completed items from a Markdown checklist (structured, no LLM)
#   "notes" — a hand-written update file (structured, no LLM)
# A run reports every enabled signal as a titled section in one message.
collectors = ["git"]

# File paths for the structured collectors. Each is REQUIRED only when its
# collector is listed above (a relative path resolves next to this config file).
# Uncomment alongside enabling "tasks" / "notes" in `collectors`:
#   collectors = ["git", "tasks", "notes"]
# tasks_file = "TODO.md"    # a Markdown checklist; "- [x]" lines are reported when newly checked
# notes_file = "NOTES.md"   # a hand-written "current update"; re-sent whenever its content changes

# Named recipients of this project's reports. Listed explicitly (not an implicit
# "me") so a shared multi-supervisor service can be added later without a rewrite.
# A recipient names a DESTINATION (a channel + its webhook): several people watching
# one channel = one recipient. List as many recipients as you like; each run reports
# to all of them, formatted for and delivered to each one's channel.
[[projects.orion.recipients]]
name = "Alex (supervisor)"
channel = "discord"                       # "discord" or "slack".
webhook_env_var = "ORION_DISCORD_WEBHOOK_ALEX"   # names the .env key holding the URL.

# A Slack recipient: same shape, channel = "slack", pointing at a Slack incoming
# webhook in .env. Uncomment to also report to a Slack channel.
# [[projects.orion.recipients]]
# name = "Sam (supervisor)"
# channel = "slack"
# webhook_env_var = "ORION_SLACK_WEBHOOK_SAM"
